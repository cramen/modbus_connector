{
  "name": "Wiren Board WB-MS v.2",
  "description": "Wall-mount sensor: temperature, humidity, illuminance, air quality (VOC); two universal inputs (1-Wire DS18B20 or discrete with counters), TH sensor heater (default 9600 8N2, address on device label). Register map: https://github.com/wirenboard/wb-mqtt-serial/blob/master/templates/config-wb-ms_v2.json",
  "connection": {
    "type": "RTU",
    "rtu_baud": "9600",
    "rtu_bytesize": "8",
    "rtu_parity": "N",
    "rtu_stopbits": "2",
    "timeout": 3.0
  },
  "registers": [
    {
      "name": "Temperature",
      "kind": "input_registers",
      "address": 4,
      "count": 1,
      "format": "s16",
      "scale": 0.01,
      "unit": "°C"
    },
    {
      "name": "Humidity",
      "kind": "input_registers",
      "address": 5,
      "count": 1,
      "format": "s16",
      "scale": 0.01,
      "unit": "%"
    },
    {
      "name": "Illuminance",
      "kind": "input_registers",
      "address": 2,
      "count": 1,
      "unit": "lx"
    },
    {
      "name": "Air quality (VOC)",
      "kind": "input_registers",
      "address": 11,
      "count": 1,
      "unit": "ppb"
    },
    {
      "name": "External Sensor 1",
      "kind": "input_registers",
      "address": 6,
      "count": 1,
      "format": "s16",
      "scale": 0.0625,
      "unit": "°C"
    },
    {
      "name": "External Sensor 2",
      "kind": "input_registers",
      "address": 7,
      "count": 1,
      "format": "s16",
      "scale": 0.0625,
      "unit": "°C"
    },
    {
      "name": "Input 1 state",
      "kind": "discrete_inputs",
      "address": 0,
      "count": 1
    },
    {
      "name": "Input 2 state",
      "kind": "discrete_inputs",
      "address": 1,
      "count": 1
    },
    {
      "name": "Input 1 counter",
      "kind": "input_registers",
      "address": 277,
      "count": 1
    },
    {
      "name": "Input 2 counter",
      "kind": "input_registers",
      "address": 278,
      "count": 1
    },
    {
      "name": "TH sensor heater",
      "kind": "coils",
      "address": 2,
      "count": 1
    },
    {
      "name": "Supply voltage",
      "kind": "input_registers",
      "address": 121,
      "count": 1,
      "scale": 0.001,
      "unit": "V"
    },
    {
      "name": "Uptime",
      "kind": "input_registers",
      "address": 104,
      "count": 2,
      "format": "u32",
      "unit": "s"
    },
    {
      "name": "MCU temperature",
      "kind": "input_registers",
      "address": 124,
      "count": 1,
      "format": "s16",
      "scale": 0.1,
      "unit": "°C"
    }
  ]
}
