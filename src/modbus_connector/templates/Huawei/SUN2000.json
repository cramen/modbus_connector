      "scale": 0.001,
      "unit": "kW"
    },
    {
      "name": "State 1 (bitfield)",
      "address": 32000,
      "count": 1,
      "format": "hex",
      "bitmask": true,
      "value_names": {
        "0": "Standby",
        "1": "Grid-Connected",
        "2": "Grid-Connected normally",
        "3": "Derating: power rationing",
        "4": "Derating: internal causes",
        "5": "Normal stop",
        "6": "Stop due to faults",
        "7": "Stop due to power rationing",
        "8": "Shutdown",
        "9": "Spot check"
      }
    },
