{
  "name": "Huawei SUN2000",
  "description": "Grid-tied PV inverter (SUN2000 KTL/L1/M0-M3 series). All registers are read with function 0x03 (holding); document addresses (32016 etc.) are used directly as PDU addresses — do NOT subtract offsets. Default: RTU 9600 8N1, slave 1; Modbus TCP port 502 available via SDongleA/SmartLogger (switch type to TCP, host = dongle IP). Source: Huawei Solar Inverter Modbus Interface Definitions, Issue 04 (2023-01-10), https://community.symcon.de/uploads/short-url/g80bOFCOJbpY2zKvpaA30EdGNDK.pdf",
  "connection": {
    "type": "RTU",
    "rtu_baud": "9600",
    "rtu_bytesize": "8",
    "rtu_parity": "N",
    "rtu_stopbits": "1",
    "unit": 1,
    "timeout": 3.0
  },
  "registers": [
    {
      "name": "Model name",
      "address": 30000,
      "count": 15,
      "format": "ascii"
    },
    {
      "name": "Serial number",
      "address": 30015,
      "count": 10,
      "format": "ascii"
    },
    {
      "name": "Model ID",
      "address": 30070,
      "count": 1
    },
    {
      "name": "Number of PV strings",
      "address": 30071,
      "count": 1
    },
    {
