{
  "name": "Delta VFD-MS300",
  "description": "Compact VFD, Modbus RS-485 (default 9600; factory protocol is ASCII 7N2 - set Pr.09-04=12 for RTU 8N1). Register map: MS300 User Manual ch.12.1-09, https://delta-automation.at/wp-content/uploads/2020/01/DELTA_IA-MDS_VFD-MS300_UM_EN_20191230.pdf",
  "connection": {
    "type": "RTU",
    "rtu_baud": "9600",
    "rtu_bytesize": "8",
    "rtu_parity": "N",
    "rtu_stopbits": "1",
    "unit": 1,
    "timeout": 1.0
  },
  "registers": [
